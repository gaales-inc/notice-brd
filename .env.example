# Database: either DATABASE_URL, or the DB_* parts (the server uses DB_* on the compose network).
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=noticebrd
DB_PASSWORD=
DB_NAME=noticebrd
# Only for an external database that requires TLS
DB_SSL=false

# Local development without Postgres: keep the database in this folder with PGlite.
# PGLITE_DIR=.data

PORT=3000
# Used in emails (invitation links).
APP_URL=https://noticebrd.gaales.com

# mailr: internal mail service, compose-network only. Sign-in codes can't be sent without the key.
MAILR_URL=http://mailr:8025
MAILR_API_KEY=
# Log mail (including sign-in codes) instead of sending it. Local development only.
MAILR_DEV_CONSOLE=
